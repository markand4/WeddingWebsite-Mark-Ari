# Copy to .env for local development (never commit .env)
# -------------------------------------------------------

# Option A: single connection string (recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wedding

# Option B: individual params (used if DATABASE_URL is not set)
# DB_USER=postgres
# DB_PASS=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=wedding

NODE_ENV=development
PORT=3000
